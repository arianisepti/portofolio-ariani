      .portfolio-card-cta:hover {
        color: #0B5ED9;
      }
      
      .portfolio-card-cta:hover .arrow {
        transform: translateX(4px);
      }
      
      /* ===== NAVIGATION ===== */
      .portfolio-nav {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 1px solid #DCE8F5;
        background: #FFFFFF;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
        flex-shrink: 0;
        color: #1677FF;
        box-shadow: 0 2px 8px rgba(15, 50, 90, 0.04);
      }
      
      .portfolio-nav:hover {
        background: #F1F7FF;
        border-color: #1677FF;
        box-shadow: 0 4px 12px rgba(22, 119, 255, 0.12);
      }
      
      .portfolio-nav svg {
        width: 18px;
        height: 18px;
      }
      
      /* ===== INDICATORS ===== */
      .portfolio-indicators {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 1.25rem;
      }
      
      .portfolio-dot-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #D8E2EE;
        cursor: pointer;
        transition: all 0.3s ease;
      }
      
      .portfolio-dot-indicator.active {
        background: #1677FF;
        width: 24px;
        border-radius: 4px;
        box-shadow: 0 0 12px rgba(22, 119, 255, 0.2);
      }
      
      .portfolio-dot-indicator:hover {
        background: #1677FF;
      }
      
      /* ========================================== */
      /* MODAL PORTOFOLIO                           */
      /* ========================================== */
      .portfolio-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(11, 31, 68, 0.45);
        backdrop-filter: blur(6px);
        z-index: 1000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
      }
      
      .portfolio-modal-overlay.open {
        display: flex;
      }

      /* ===== GAMBAR PORTOFOLIO ===== */
      .portfolio-card-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.3s ease;
      }

      .portfolio-card:hover .portfolio-card-img {
        transform: scale(1.04);
      }


      .portfolio-modal-img {
        width: 100%;
        height: 100%;
        max-height: 400px;
        object-fit: contain;
        border-radius: 12px;
        display: block;
      }

      /* ========================================== */
      /* LIGHTBOX (Zoom Gambar)                     */
      /* ========================================== */
      .lightbox-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(8px);
        z-index: 2000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        animation: lightboxFadeIn 0.3s ease-out;
      }
      
      .lightbox-overlay.open {
        display: flex;
      }
      
      @keyframes lightboxFadeIn {
        0% { opacity: 0; }
        100% { opacity: 1; }
      }
      
      .lightbox-img {
        max-width: 90vw;
        max-height: 85vh;
        width: auto;
        height: auto;
        object-fit: contain;
        border-radius: 12px;
        box-shadow: 0 20px 80px rgba(0, 0, 0, 0.5);
        animation: lightboxZoomIn 0.3s ease-out;
        cursor: zoom-out;
      }
      
      @keyframes lightboxZoomIn {
        0% { transform: scale(0.9); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
