      @media (max-width: 480px) {
        .footer-section {
          padding: 1rem 0 0.25rem;
        }
        
        .footer-container {
          padding: 0 0.75rem;
        }
        
        .footer-grid {
          grid-template-columns: 1fr 1fr;
