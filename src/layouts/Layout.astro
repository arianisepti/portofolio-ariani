      .portfolio-section {
        padding: 2.5rem 0;
        background: transparent;
        position: relative;
        overflow: hidden;
      }
      
      .portfolio-bg {
        position: absolute;
        inset: 0;
        background: transparent;
        z-index: 0;
      }
      
      .portfolio-dots {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        overflow: hidden;
      }
      
      .portfolio-dot {
        position: absolute;
        border-radius: 50%;
        opacity: 0.2;
      }
      
      .portfolio-arc {
        position: absolute;
        border-radius: 50%;
        border: 1px solid rgba(22, 119, 255, 0.05);
        pointer-events: none;
        z-index: 1;
      }
      
      .portfolio-glow {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        z-index: 1;
        opacity: 0.5;
      }
      
      .portfolio-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
        position: relative;
        z-index: 2;
      }
      
      /* ===== HEADING ===== */
      .portfolio-header {
        text-align: center;
        margin-bottom: 2rem;
      }
      
      .portfolio-heading {
        font-family: 'Inter', 'Poppins', sans-serif;
        font-size: 2rem;
        font-weight: 700;
        color: #0B1F44;
        margin: 0;
      }
      
      .portfolio-subheading {
        font-size: 0.85rem;
        color: #64748B;
        margin: 0.1rem 0 0.25rem;
        font-weight: 400;
      }
      
      .portfolio-underline {
        width: 40px;
        height: 3px;
        background: linear-gradient(90deg, #1677FF, #14C8C4);
        border-radius: 2px;
        margin: 0.25rem auto 0;
      }
      
      /* ===== CAROUSEL ===== */
      .portfolio-carousel-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      
      .portfolio-carousel {
        display: flex;
        gap: 1.25rem;
        overflow-x: auto;
        scroll-behavior: smooth;
        padding: 0.5rem 0.25rem;
        scrollbar-width: none;
        -ms-overflow-style: none;
        flex: 1;
      }
      
      .portfolio-carousel::-webkit-scrollbar {
        display: none;
      }
      
      /* ===== CARD ===== */
      .portfolio-card {
        min-width: 260px;
        max-width: 280px;
        flex: 0 0 auto;
        background: #FFFFFF;
        border: 1px solid #DCE8F5;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 3px 12px rgba(15, 50, 90, 0.04);
        transition: all 0.3s ease;
        cursor: pointer;
      }
      
      .portfolio-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 28px rgba(15, 50, 90, 0.08);
        border-color: #BBD9FF;
      }
      
      .portfolio-card-image {
        position: relative;
        height: 140px;
        overflow: hidden;
        background: #F5F9FF;
      }
      
      .portfolio-card-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.3s ease;
      }
      
      .portfolio-card:hover .portfolio-card-placeholder {
        transform: scale(1.04);
      }
      
      .portfolio-card-overlay {
        position: absolute;
        inset: 0;
        background: rgba(11, 31, 68, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
      }
      
      .portfolio-card:hover .portfolio-card-overlay {
        opacity: 1;
      }
      
      .portfolio-card-overlay-text {
        color: #FFFFFF;
        font-size: 0.8rem;
        font-weight: 600;
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(4px);
        padding: 0.4rem 1rem;
