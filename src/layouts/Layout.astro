---
// Layout utama
export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Portofolio Ariani Dwi Septi" } = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    
    <!-- Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <style is:global>
      /* RESET */
      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      /* ========================================== */
      /* GLOBAL BACKGROUND (MOTIF & ANIMASI)        */
      /* ========================================== */
      .global-bg {
        position: fixed;
        inset: 0;
        z-index: -1; /* Di belakang semua konten */
        background-color: #FAFCFF; /* Putih dengan sedikit nuansa biru */
        overflow: hidden;
        pointer-events: none; /* Agar tidak menghalangi klik */
      }

      /* 1. Motif Grid Halus */
      .bg-grid {
        position: absolute;
        inset: 0;
        background-image: 
          linear-gradient(to right, rgba(22, 119, 255, 0.04) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(22, 119, 255, 0.04) 1px, transparent 1px);
        background-size: 40px 40px;
        /* Efek fade-out di pinggir */
        mask-image: radial-gradient(circle at center, black 40%, transparent 100%);
        -webkit-mask-image: radial-gradient(circle at center, black 40%, transparent 100%);
      }

      /* 2. Glow / Aurora Halus */
      .bg-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.4;
        animation: floatGlow 15s ease-in-out infinite alternate;
      }

      .bg-glow-1 {
        width: 500px;
        height: 500px;
        background: rgba(22, 119, 255, 0.2); /* Biru */
        top: -10%;
        left: -10%;
      }

      .bg-glow-2 {
        width: 600px;
        height: 600px;
        background: rgba(20, 200, 196, 0.15); /* Cyan/Teal */
        bottom: -20%;
        right: -10%;
        animation-delay: -5s;
      }

      @keyframes floatGlow {
        0% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(50px, 30px) scale(1.1); }
        100% { transform: translate(-30px, 50px) scale(0.9); }
      }

      /* 3. Partikel Mengambang */
      .bg-particles {
        position: absolute;
        inset: 0;
      }

      .particle {
        position: absolute;
        bottom: -10px;
        width: 4px;
        height: 4px;
        background: #1677FF;
        border-radius: 50%;
        opacity: 0;
        animation: floatUp 15s linear infinite;
        box-shadow: 0 0 10px 2px rgba(22, 119, 255, 0.4);
      }

      .particle:nth-child(even) {
        background: #14C8C4; /* Cyan */
        box-shadow: 0 0 10px 2px rgba(20, 200, 196, 0.4);
        width: 3px;
        height: 3px;
      }

      @keyframes floatUp {
        0% {
          transform: translateY(0);
          opacity: 0;
        }
        10% {
          opacity: 0.6;
        }
        90% {
          opacity: 0.6;
        }
        100% {
          transform: translateY(-100vh);
          opacity: 0;
        }
      }
      
      /* ===== SISA CSS ANDA ... ===== */
      body {
        font-family: 'Inter', 'Poppins', sans-serif;
        /* background: #FFFFFF;  <-- INI KITA UBAH */
        background: transparent; 
        min-height: 100vh;
        color: #0B1F44;
        overflow-x: hidden;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      body {
        font-family: 'Inter', 'Poppins', sans-serif;
        background: #FFFFFF;
        min-height: 100vh;
        color: #0B1F44;
        overflow-x: hidden;
      }
      
      /* ===== NAVBAR ===== */
      .navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 50;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(0, 0, 0, 0.04);
        padding: 0 2rem;
        height: 72px;
        display: flex;
        align-items: center;
      }
      
      .navbar-container {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
      }
      
      .navbar-logo {
        font-family: 'Inter', 'Poppins', sans-serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: #0B1F44;
        text-decoration: none;
        transition: color 0.3s ease;
        letter-spacing: -0.3px;
      }
      .navbar-logo:hover { color: #1677FF; }
      
      .navbar-menu {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        list-style: none;
      }
      
      .navbar-menu a {
        color: #475569;
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 500;
        padding: 0.4rem 0.75rem;
        border-radius: 0.4rem;
        transition: all 0.3s ease;
        white-space: nowrap;
      }
      
      .navbar-menu a:hover {
        color: #0B1F44;
        background: rgba(22, 119, 255, 0.06);
      }
      
      .navbar-cta {
        background: #1677FF;
        color: #FFFFFF;
        font-weight: 600;
        font-size: 0.8rem;
        padding: 0.4rem 1.25rem;
        border-radius: 8px;
        text-decoration: none;
        transition: all 0.3s ease;
        white-space: nowrap;
      }
      .navbar-cta:hover {
        background: #0B5ED9;
        transform: translateY(-1px);
        box-shadow: 0 4px 16px rgba(22, 119, 255, 0.3);
      }
      
      /* Hamburger */
      .hamburger {
        display: none;
        flex-direction: column;
        gap: 4px;
        cursor: pointer;
        padding: 8px;
        background: transparent;
        border: none;
      }
      
      .hamburger span {
        display: block;
        width: 22px;
        height: 2px;
        background: #0B1F44;
        border-radius: 2px;
        transition: all 0.3s ease;
      }
      
      /* Mobile Menu */
      .mobile-menu {
        display: none;
        background: #FFFFFF;
        border-top: 1px solid rgba(0, 0, 0, 0.04);
        padding: 0.75rem 1.5rem 1.5rem;
      }
      
      .mobile-menu a {
        display: block;
        color: #475569;
        text-decoration: none;
        padding: 0.6rem 0.5rem;
        font-size: 0.9rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.03);
        transition: color 0.3s ease;
      }
      
      .mobile-menu a:hover { color: #0B1F44; }
      
      .mobile-menu .cta-mobile {
        margin-top: 0.5rem;
        background: #1677FF;
        color: #FFFFFF;
        text-align: center;
        font-weight: 600;
        padding: 0.6rem;
        border-radius: 8px;
        border-bottom: none;
      }
      .mobile-menu .cta-mobile:hover {
        background: #0B5ED9;
      }
      
      @media (max-width: 1023px) {
        .navbar-menu { display: none; }
        .navbar-cta { display: none; }
        .hamburger { display: flex; }
        .mobile-menu.open { display: block; }
      }
      
      @media (min-width: 1024px) {
        .mobile-menu { display: none !important; }
      }
      
      /* ===== HERO SECTION ===== */
      .hero-section {
        min-height: 100vh;
        display: flex;
        align-items: center;
        padding-top: 72px;
        padding-bottom: 2rem;
        background: transparent;
        position: relative;
        overflow: hidden;
      }
      
      /* Background dengan gradient dan titik */
      .hero-bg {
        position: absolute;
        inset: 0;
        background: transparent;
        z-index: 0;
      }
      
      /* Titik-titik dekoratif */
      .hero-dots {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        overflow: hidden;
      }
      
      .hero-dot {
        position: absolute;
        border-radius: 50%;
        opacity: 0.25;
      }
      
      /* Garis orbit */
      .hero-orbit {
        position: absolute;
        border-radius: 50%;
        border: 1px solid rgba(22, 119, 255, 0.08);
        pointer-events: none;
      }
      
      .hero-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 2rem;
        display: flex;
        align-items: center;
        gap: 3rem;
        width: 100%;
        position: relative;
        z-index: 2;
        min-height: 600px;
      }
      
      /* ===== KIRI: KONTEN TEKS ===== */
      .hero-content {
        flex: 0 0 55%;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      
      /* Badge */
      .hero-badge {
        display: inline-block;
        background: #F0F7FF;
        border: 1px solid #BBD9FF;
        color: #1677FF;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        padding: 0.25rem 0.9rem;
        border-radius: 20px;
        text-transform: uppercase;
        width: fit-content;
        margin-bottom: 0.25rem;
      }
      
      /* Greeting */
      .hero-greeting {
        color: #0B1F44;
        font-size: 2rem;
        font-weight: 700;
        line-height: 1.2;
        margin: 0;
      }
      
      /* Nama dengan gradient */
      .hero-name {
        font-size: 3.2rem;
        font-weight: 800;
        line-height: 1.05;
        background: linear-gradient(90deg, #1677FF, #14C8C4);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin: 0;
      }
      
      /* Tagline */
      .hero-tagline {
        color: #263B5A;
        font-size: 1.05rem;
        font-weight: 600;
        margin: 0;
      }
      
      /* Deskripsi */
      .hero-desc {
        color: #64748B;
        font-size: 0.8rem;
        line-height: 1.6;
        max-width: 480px;
        margin: 0;
      }
      
      /* Feature Cards */
      .hero-features {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
      }
      
      .hero-feature {
        background: #FFFFFF;
        border: 1px solid #DCE8F5;
        border-radius: 10px;
        padding: 0.6rem 0.9rem;
        box-shadow: 0 4px 12px rgba(15, 50, 90, 0.06);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex: 1;
        min-width: 100px;
        transition: all 0.3s ease;
      }
      
      .hero-feature:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(15, 50, 90, 0.08);
      }
      
      .hero-feature-icon {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 0.85rem;
      }
      
      .hero-feature-icon.blue {
        background: rgba(22, 119, 255, 0.12);
        color: #1677FF;
      }
      
      .hero-feature-icon.cyan {
        background: rgba(20, 200, 196, 0.12);
        color: #14C8C4;
      }
      
      .hero-feature-text {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
      }
      
      .hero-feature-text .line1 {
        font-size: 0.7rem;
        font-weight: 500;
        color: #475569;
      }
      
      .hero-feature-text .line2 {
        font-size: 0.75rem;
        font-weight: 700;
        color: #0B1F44;
      }
      
      /* CTA Buttons */
      .hero-buttons {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
      }
      
      .btn-primary {
        background: #1677FF;
        color: #FFFFFF;
        padding: 0.65rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.8rem;
        border: none;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(22, 119, 255, 0.25);
      }
      
      .btn-primary:hover {
        background: #0B5ED9;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(22, 119, 255, 0.35);
      }
      
      .btn-secondary {
        background: #FFFFFF;
        color: #0B1F44;
        padding: 0.65rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.8rem;
        border: 1px solid #B9CBE0;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: all 0.3s ease;
      }
      
      .btn-secondary:hover {
        background: #F5F9FF;
        border-color: #1677FF;
        transform: translateY(-2px);
      }
      
      /* Social */
      .hero-social {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.25rem;
      }
      
      .hero-social-label {
        color: #64748B;
        font-size: 0.7rem;
        font-weight: 400;
      }
      
      .hero-social a {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 1px solid #E2EAF3;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #0B1F44;
        transition: all 0.3s ease;
        text-decoration: none;
      }
      
      .hero-social a:hover {
        border-color: #1677FF;
        color: #1677FF;
        transform: translateY(-2px);
      }
      
      .hero-social svg {
        width: 14px;
        height: 14px;
        fill: currentColor;
      }
      
      /* ===== KANAN: FOTO ===== */
      .hero-right {
        flex: 0 0 45%;
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
      }
      
      /* Glow di belakang foto */
      .hero-glow {
        position: absolute;
        width: 450px;
        height: 450px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(22, 119, 255, 0.06), transparent 70%);
        pointer-events: none;
      }
      
      /* Foto */
      .hero-photo-wrapper {
        position: relative;
        width: 350px;
        height: 350px;
      }
      
      .hero-photo {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid transparent;
        background-image: linear-gradient(#FFFFFF, #FFFFFF), linear-gradient(135deg, #1677FF, #14C8C4);
        background-origin: border-box;
        background-clip: padding-box, border-box;
        box-shadow: 0 0 0 1px rgba(22, 119, 255, 0.08), 0 20px 60px rgba(22, 119, 255, 0.08);
        position: relative;
        z-index: 2;
      }
      
      /* Floating Card */
      .floating-card {
        position: absolute;
        background: #FFFFFF;
        border: 1px solid #E2EAF3;
        border-radius: 10px;
        padding: 0.8rem 1rem;
        box-shadow: 0 8px 32px rgba(15, 50, 90, 0.08);
        z-index: 3;
        min-width: 130px;
      }
      
      .floating-card .card-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.2rem 0;
        font-size: 0.6rem;
        color: #475569;
      }
      
      .floating-card .card-item .icon {
        width: 20px;
        height: 20px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.6rem;
        flex-shrink: 0;
      }
      
      .floating-card .card-item .icon.blue { background: rgba(22, 119, 255, 0.1); color: #1677FF; }
      .floating-card .card-item .icon.cyan { background: rgba(20, 200, 196, 0.1); color: #14C8C4; }
      
      .floating-card .card-item .label { font-weight: 400; }
      .floating-card .card-item .value { font-weight: 600; color: #0B1F44; }
      
      /* Posisi Floating Card */
      .floating-card.pos-1 {
        bottom: 10%;
        right: -10%;
      }
      
      /* Decorative Elements */
      .deco-circle {
        position: absolute;
        border-radius: 50%;
        border: 1px solid rgba(22, 119, 255, 0.1);
        pointer-events: none;
        z-index: 1;
      }
      
      .deco-dot {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        z-index: 1;
      }
      
      /* ===== RESPONSIVE ===== */
      @media (max-width: 1024px) {
        .hero-container {
          flex-direction: column;
          gap: 2rem;
          padding: 1.5rem;
        }
        
        .hero-content {
          flex: 1;
          width: 100%;
          text-align: center;
          align-items: center;
        }
        
        .hero-desc {
          max-width: 100%;
        }
        
        .hero-features {
          justify-content: center;
        }
        
        .hero-buttons {
          justify-content: center;
        }
        
        .hero-social {
          justify-content: center;
        }
        
        .hero-right {
          flex: 1;
          width: 100%;
        }
        
        .hero-photo-wrapper {
          width: 250px;
          height: 250px;
        }
        
        .hero-glow {
          width: 300px;
          height: 300px;
        }
        
        .floating-card.pos-1 {
          bottom: 0;
          right: 0;
        }
        
        .hero-name {
          font-size: 2.5rem;
        }
        
        .hero-greeting {
          font-size: 1.5rem;
        }
      }
      
      @media (max-width: 640px) {
        .hero-container {
          padding: 1rem;
          gap: 1.5rem;
        }
        
        .hero-photo-wrapper {
          width: 180px;
          height: 180px;
        }
        
        .hero-glow {
          width: 220px;
          height: 220px;
        }
        
        .hero-name {
          font-size: 2rem;
        }
        
        .hero-greeting {
          font-size: 1.25rem;
        }
        
        .hero-tagline {
          font-size: 0.9rem;
        }
        
        .hero-desc {
          font-size: 0.7rem;
        }
        
        .hero-feature {
          min-width: 80px;
          padding: 0.4rem 0.6rem;
        }
        
        .hero-feature-text .line1 { font-size: 0.6rem; }
        .hero-feature-text .line2 { font-size: 0.65rem; }
        
        .btn-primary, .btn-secondary {
          padding: 0.5rem 1rem;
          font-size: 0.7rem;
        }
        
        .floating-card {
          display: none;
        }
        
        .hero-badge {
          font-size: 0.55rem;
          padding: 0.15rem 0.6rem;
        }
      }

              /* ===== SIDEBAR ===== */
      .sidebar {
        position: fixed;
        top: 0;
        right: 0;
        height: 100%;
        width: 80%;
        max-width: 320px;
        background: #FFFFFF;
        z-index: 999;
        transform: translateX(100%);
        transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        box-shadow: -4px 0 30px rgba(0, 0, 0, 0.08);
        padding: 1.5rem 1.5rem 2rem;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
      }
      
      .sidebar.open {
        transform: translateX(0);
      }
      
      .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 1rem;
        border-bottom: 1px solid #F1F5F9;
        margin-bottom: 1rem;
      }
      
      .sidebar-header-title {
        font-family: 'Inter', 'Poppins', sans-serif;
        font-size: 1rem;
        font-weight: 700;
        color: #0B1F44;
      }
      
      .sidebar-close {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: none;
        background: transparent;
        color: #475569;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
      }
      
      .sidebar-close:hover {
        background: #F1F5F9;
        color: #0B1F44;
      }
      
      .sidebar-close svg {
        width: 20px;
        height: 20px;
        stroke: currentColor;
        stroke-width: 2;
      }
      
      .sidebar-nav {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        flex: 1;
      }
      
      .sidebar-nav a {
        color: #475569;
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 500;
        padding: 0.7rem 0.75rem;
        border-radius: 8px;
        transition: all 0.3s ease;
      }
      
      .sidebar-nav a:hover {
        color: #0B1F44;
        background: #F1F5F9;
      }
      
      .sidebar-nav .sidebar-cta {
        margin-top: 0.5rem;
        background: #1677FF;
        color: #FFFFFF;
        text-align: center;
        font-weight: 600;
        border-radius: 8px;
      }
      
      .sidebar-nav .sidebar-cta:hover {
        background: #0B5ED9;
        color: #FFFFFF;
      }
      
      /* ===== OVERLAY ===== */
      .sidebar-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.3);
        z-index: 998;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
      }
      
      .sidebar-overlay.open {
        opacity: 1;
        visibility: visible;
      }
      
      /* ===== HAMBURGER ACTIVE ===== */
      .hamburger.active span:nth-child(1) {
        transform: rotate(45deg) translate(4px, 4px);
      }
      
      .hamburger.active span:nth-child(2) {
        opacity: 0;
      }
      
      .hamburger.active span:nth-child(3) {
        transform: rotate(-45deg) translate(4px, -4px);
      }


      /* ========================================== */
      /* TENTANG SAYA                               */
      /* ========================================== */
      .about-section {
        padding: 2.5rem 0;
        background: transparent;
        position: relative;
        overflow: hidden;
      }
      
      .about-bg {
        position: absolute;
        inset: 0;
        background: transparent;
        z-index: 0;
      }
      
      .about-dots {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        overflow: hidden;
      }
      
