        <span class="particle" style="left: 10%; animation-duration: 12s; animation-delay: 0s;"></span>
        <span class="particle" style="left: 25%; animation-duration: 18s; animation-delay: 2s;"></span>
        <span class="particle" style="left: 40%; animation-duration: 15s; animation-delay: 4s;"></span>
        <span class="particle" style="left: 55%; animation-duration: 20s; animation-delay: 1s;"></span>
        <span class="particle" style="left: 70%; animation-duration: 14s; animation-delay: 5s;"></span>
        <span class="particle" style="left: 85%; animation-duration: 16s; animation-delay: 3s;"></span>
        <span class="particle" style="left: 95%; animation-duration: 22s; animation-delay: 6s;"></span>
