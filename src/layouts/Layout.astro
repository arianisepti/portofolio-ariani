      .footer-col-link {
        font-size: 0.55rem;
        color: #94A3B8;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-block;
        position: relative;
      }
      
      .footer-col-link::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 0;
        width: 0;
        height: 1px;
        background: #00D4FF;
        transition: width 0.3s ease;
      }
      
      .footer-col-link:hover {
        color: #00D4FF;
      }
      
      .footer-col-link:hover::after {
        width: 100%;
      }
      
      /* ===== SOCIAL ===== */
      .footer-social {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
      }
      
      .footer-social-link {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 1px solid #1E3A5F;
