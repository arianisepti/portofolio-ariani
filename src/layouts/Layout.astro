        gap: 0.5rem;
      }
      
      /* ===== SKILL TAGS ===== */
      .skills-tag {
        background: #F1F5F9;
        color: #0B1E36;
        border: 1px solid #E2E8F0;
        border-radius: 20px;
        padding: 0.3rem 0.8rem;
