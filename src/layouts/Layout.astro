      .portfolio-card-desc {
        font-size: 0.7rem;
        color: #475569;
        margin: 0 0 0.5rem;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
