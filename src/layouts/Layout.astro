        margin-top: 0.25rem;
      }
      
      .footer-back-top:hover {
        transform: scale(1.08);
        box-shadow: 0 6px 24px rgba(0, 212, 255, 0.3);
        background: #00E5A0;
      }
      
      .footer-back-top svg {
        width: 16px;
        height: 16px;
        stroke: currentColor;
        stroke-width: 2.5;
      }
      
      /* ===== DIVIDER ===== */
      .footer-divider {
        border-top: 1px solid #1E3A5F;
        margin: 1rem 0 0.5rem;
        opacity: 0.7;
      }
      
      /* ===== COPYRIGHT ===== */
      .footer-copyright {
        font-size: 0.5rem;
        color: #64748B;
        text-align: center;
        margin: 0;
        padding: 0.25rem 0 0.5rem;
        font-weight: 400;
        letter-spacing: 0.3px;
      }
      
      /* ===== RESPONSIVE ===== */
      @media (max-width: 1024px) {
        .footer-grid {
          grid-template-columns: 1.8fr 1fr 1fr 1fr 36px;
          gap: 1rem;
        }
        
        .footer-col-identity {
          max-width: 180px;
        }
      }
      
      @media (max-width: 768px) {
        .footer-section {
          padding: 1.25rem 0 0.5rem;
        }
        
        .footer-container {
          padding: 0 1rem;
        }
        
        .footer-grid {
          grid-template-columns: 1fr 1fr;
          gap: 0.75rem 1.5rem;
        }
        
        .footer-col-identity {
          max-width: 100%;
