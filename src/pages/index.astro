  <!-- HERO SECTION                               -->
  <!-- ========================================== -->
  <section class="hero-section" id="beranda">
    
    <!-- Background -->
    <div class="hero-bg"></div>
    
    <!-- Dekorasi Titik -->
    <div class="hero-dots">
      <div class="hero-dot" style="width:6px;height:6px;background:#16C7D9;top:15%;left:8%;opacity:0.3;"></div>
      <div class="hero-dot" style="width:4px;height:4px;background:#4DA3FF;top:25%;left:92%;opacity:0.4;"></div>
      <div class="hero-dot" style="width:5px;height:5px;background:#16C7D9;top:45%;left:5%;opacity:0.25;"></div>
      <div class="hero-dot" style="width:3px;height:3px;background:#4DA3FF;top:70%;left:95%;opacity:0.35;"></div>
      <div class="hero-dot" style="width:4px;height:4px;background:#1677FF;top:80%;left:10%;opacity:0.2;"></div>
