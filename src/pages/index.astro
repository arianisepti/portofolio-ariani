    // ===== DOM ELEMENTS =====
    var carousel = document.getElementById('portfolioCarousel');
    var prevBtn = document.getElementById('prevBtn');
    var nextBtn = document.getElementById('nextBtn');
    var indicators = document.querySelectorAll('.portfolio-dot-indicator');
    var modal = document.getElementById('portfolioModal');
    var modalClose = document.getElementById('modalClose');
    var overlay = modal;
    
    // ===== CAROUSEL SCROLL =====
    function scrollCarousel(direction) {
      var cardWidth = carousel.querySelector('.portfolio-card').offsetWidth + 20; // card + gap
      var scrollAmount = cardWidth * (direction === 'next' ? 1 : -1);
      carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    }
    
    if (prevBtn) {
      prevBtn.addEventListener('click', function() { scrollCarousel('prev'); });
    }
    
    if (nextBtn) {
      nextBtn.addEventListener('click', function() { scrollCarousel('next'); });
    }
    
    // ===== UPDATE INDICATORS =====
    function updateIndicators() {
      var scrollLeft = carousel.scrollLeft;
      var cardWidth = carousel.querySelector('.portfolio-card').offsetWidth + 20;
      var index = Math.round(scrollLeft / cardWidth);
      if (index >= indicators.length) index = indicators.length - 1;
      
      indicators.forEach(function(dot, i) {
        dot.classList.toggle('active', i === index);
      });
    }
    
    carousel.addEventListener('scroll', updateIndicators);
    
    // ===== CLICK INDICATOR =====
    indicators.forEach(function(dot) {
      dot.addEventListener('click', function() {
        var index = parseInt(this.dataset.index);
        var cardWidth = carousel.querySelector('.portfolio-card').offsetWidth + 20;
        carousel.scrollTo({ left: index * cardWidth, behavior: 'smooth' });
      });
    });
    
    // ===== OPEN MODAL =====
    function openModal(projectId) {
      var project = projects[projectId];
      if (!project) return;
      
      // Set content
      document.getElementById('modalCategory').textContent = project.category;
      document.getElementById('modalTitle').textContent = project.title;
      document.getElementById('modalOverview').textContent = project.overview;
      var modalImg = document.getElementById('modalImage') as HTMLImageElement;
      if (modalImg) {
        modalImg.src = project.image;
        modalImg.alt = project.title;
      }


       // klik gambar untuk lightbox
      var lightboxImg = document.getElementById('modalImage');
      if (lightboxImg) {
        lightboxImg.style.cursor = 'zoom-in';
        lightboxImg.onclick = function() {
          var lightbox = document.getElementById('lightboxOverlay');
          var lightboxImgEl = document.getElementById('lightboxImg');
          if (lightbox && lightboxImgEl) {
            lightboxImgEl.setAttribute('src', project.image);
            lightbox.classList.add('open');
            document.body.style.overflow = 'hidden';
          }
        };
      }
      
      // Focus
      var focusContainer = document.getElementById('modalFocus');
      focusContainer.innerHTML = '';
      project.focus.forEach(function(item) {
        var tag = document.createElement('span');
        tag.className = 'modal-tag';
        tag.textContent = item;
        focusContainer.appendChild(tag);
      });
      
      // Tools
      var toolsContainer = document.getElementById('modalTools');
      toolsContainer.innerHTML = '';
      project.tools.forEach(function(item) {
        var tag = document.createElement('span');
        tag.className = 'modal-tag blue';
        tag.textContent = item;
        toolsContainer.appendChild(tag);
      });
      
      // Insights
      var insightsContainer = document.getElementById('modalInsights');
      insightsContainer.innerHTML = '';
      project.insights.forEach(function(item) {
        var li = document.createElement('li');
        li.textContent = item;
        insightsContainer.appendChild(li);
      });
      
      // Outcome
      document.getElementById('modalOutcome').textContent = project.outcome;
      
      // Show modal
      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    
    function closeModal() {
      modal.classList.remove('open');
      document.body.style.overflow = '';
    }
    
    // ===== CARD CLICK =====
    document.querySelectorAll('.portfolio-card, .portfolio-card-cta').forEach(function(el) {
      el.addEventListener('click', function(e) {
        e.preventDefault();
        var projectId = this.dataset.project;
        if (projectId !== undefined) {
          openModal(parseInt(projectId));
        } else {
          var card = this.closest('.portfolio-card');
          if (card) {
            var id = card.dataset.project;
            if (id !== undefined) {
              openModal(parseInt(id));
            }
          }
        }
      });
    });
    
    // ===== CLOSE MODAL =====
    if (modalClose) {
      modalClose.addEventListener('click', closeModal);
    }
    
    modal.addEventListener('click', function(e) {
      if (e.target === this) {
        closeModal();
      }
    });
    
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeModal();
      }
    });
    
    // ===== UPDATE INDICATORS ON LOAD =====
    setTimeout(updateIndicators, 100);

        // ===== LIGHTBOX CLOSE =====
    var lightboxOverlay = document.getElementById('lightboxOverlay');
    var lightboxClose = document.getElementById('lightboxClose');
    var lightboxImg = document.getElementById('lightboxImg');
    
    function closeLightbox() {
      if (lightboxOverlay) {
        lightboxOverlay.classList.remove('open');
        document.body.style.overflow = '';
      }
    }
    
    if (lightboxClose) {
      lightboxClose.addEventListener('click', closeLightbox);
    }
    
    if (lightboxOverlay) {
      lightboxOverlay.addEventListener('click', function(e) {
        if (e.target === this) {
          closeLightbox();
        }
      });
    }
    
    if (lightboxImg) {
      lightboxImg.addEventListener('click', closeLightbox);
    }
    
    // ESC key untuk close lightbox
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeLightbox();
      }
    });
    
  });
</script>

