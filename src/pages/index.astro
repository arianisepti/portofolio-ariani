          <div class="about-skill">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#14C8C4" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2"/><path d="M8 2v20"/><path d="M16 2v20"/><path d="M2 8h20"/><path d="M2 16h20"/></svg>
